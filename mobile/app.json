{
  "expo": {
    "name": "Obraxis Terreno",
    "slug": "obraxis-terreno",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "obraxis",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "cl.obraxis.terreno",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#10182E",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "cl.obraxis.terreno"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permite que Obraxis use Face ID para proteger tu sesión guardada."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#10182E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6e786dfa-f49a-4f1f-be32-b6e431a45082"
      }
    },
    "owner": "obraxis"
  }
}
